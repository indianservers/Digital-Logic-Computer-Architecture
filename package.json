{
  "name": "digital-electronics-computing-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/seo/build-pages.mjs && npm run seo:verify",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seo:routes": "node scripts/seo/generate-routes.mjs",
    "prebuild": "npm run seo:routes",
    "seo:verify": "node scripts/seo/verify-pages.mjs && node --test scripts/seo/resolve.test.mjs"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.2.5",
    "@gsap/react": "^2.1.2",
    "@material/web": "^2.5.0",
    "@vercel/functions": "^3.10.4",
    "gsap": "^3.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.4"
  }
}
